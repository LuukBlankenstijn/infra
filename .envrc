use flake

infra_root="$PWD"

sops_export() {
  local var="$1" file="$infra_root/$2" key="${3:-}" value
  if value="$(sops -d ${key:+--extract "$key"} "$file" 2>/dev/null)"; then
    export "$var=$value"
  else
    unset "$var"
    log_status "sops could not decrypt $2; $var is unset"
  fi
}

bao_jwt_export() {
  if TF_VAR_bao_jwt="$(kubectl -n openbao create token openbao-admin --request-timeout=5s 2>/dev/null)"; then
    export TF_VAR_bao_jwt
  else
    unset TF_VAR_bao_jwt
    log_status "kubectl could not mint an openbao-admin token; TF_VAR_bao_jwt is unset"
  fi
}

export BAO_ADDR=https://openbao.luukblankenstijn.nl
export KUBECONFIG="$infra_root/.kube/netbird.yaml:$infra_root/.kube/config"

sops_export TF_VAR_state_passphrase secrets/tofu.yaml '["state_passphrase"]'
sops_export AWS_ACCESS_KEY_ID secrets/s3.yaml '["access_key_id"]'
sops_export AWS_SECRET_ACCESS_KEY secrets/s3.yaml '["secret_access_key"]'

source_env_if_exists .envrc.local
