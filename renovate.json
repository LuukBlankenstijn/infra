{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^flux/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^flux/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flux/.+\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/archive/refs/tags/(?<currentValue>[^/\\s]+)\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/^netbirdio\\//"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "minecraft",
        "longhorn"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "docker.io/library/mariadb"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "groupName": "frp",
      "matchPackageNames": [
        "fatedier/frpc",
        "frp"
      ]
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nix-config"
      ],
      "automerge": true
    }
  ],
  "nix": {
    "enabled": true
  }
}
