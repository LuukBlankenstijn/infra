{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^flux/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^flux/.+\\.yaml$/"
    ]
  },
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/^netbirdio\\//"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "minecraft",
        "longhorn"
      ],
      "automerge": false
    },
    {
      "groupName": "frp",
      "matchPackageNames": [
        "fatedier/frpc",
        "frp"
      ]
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nix-config"
      ],
      "automerge": true
    }
  ],
  "nix": {
    "enabled": true
  }
}
